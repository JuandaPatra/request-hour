{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "request-hour",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "request-hour"
    }
  ]
}
